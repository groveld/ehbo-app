{
  "name": "@ehbo/server",
  "version": "0.0.0",
  "private": true,
  "description": "API, oproeplogica en pushmeldingen. Draait TypeScript direct met Node (type stripping).",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.ts"
  },
  "dependencies": {
    "@ehbo/shared": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "pmtiles": "^4.5.0"
  }
}
