{
  "name": "ehbo-app",
  "version": "0.2.0",
  "private": true,
  "description": "EHBO Evenementen-app: posten, contacten, EHBO-oproepen en aanvragen tijdens evenementen.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n server,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm test --workspaces --if-present",
    "seed": "npm run seed -w server",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3"
  }
}
