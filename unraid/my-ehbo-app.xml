<?xml version="1.0"?>
<!-- Kopieer naar /boot/config/plugins/dockerMan/templates-user/my-ehbo-app.xml
     en kies daarna in Unraid: Docker › Add Container › Template: ehbo-app.
     Vervang OWNER/REPO door je GitHub-gebruiker en repository (kleine letters). -->
<Container version="2">
  <Name>ehbo-app</Name>
  <Repository>ghcr.io/OWNER/REPO:latest</Repository>
  <Registry>https://github.com/OWNER/REPO/pkgs/container/REPO</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>EHBO Evenementen-app: posten, contacten en EHBO-oproepen met pushmeldingen.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:3000]/?browser=1</WebUI>
  <ExtraParams>--user 99:100 --restart unless-stopped</ExtraParams>
  <Config Name="Webpoort" Target="3000" Default="3080" Mode="tcp" Description="Voor toegang vanaf je thuisnetwerk. De Cloudflare-tunnel wijst via het Docker-netwerk naar ehbo-app:3000." Type="Port" Display="always" Required="false" Mask="false">3080</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/ehbo-app" Mode="rw" Description="Database en VAPID-sleutels. Maak hier back-ups van." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ehbo-app</Config>
  <Config Name="VAPID_SUBJECT" Target="VAPID_SUBJECT" Default="mailto:beheer@jouwdomein.nl" Mode="" Description="Contactadres voor de push-diensten van Apple en Google (mailto:... of https://...)." Type="Variable" Display="always" Required="true" Mask="false">mailto:beheer@jouwdomein.nl</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Amsterdam" Mode="" Description="Tijdzone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Amsterdam</Config>
</Container>
